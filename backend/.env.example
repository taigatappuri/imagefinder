APP_ENV=development
HTTP_ADDR=:8080
FRONTEND_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://imagefinder:imagefinder@localhost:5432/imagefinder?sslmode=disable
DB_AUTO_MIGRATE=true
SESSION_SECRET=change-me
SESSION_TTL=168h
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
GOOGLE_OAUTH_SCOPES="https://www.googleapis.com/auth/photoslibrary.readonly openid email"
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_PHOTOS_API_BASE=https://photoslibrary.googleapis.com/v1
GOOGLE_PHOTOS_PAGE_SIZE=50

GEMINI_MODE=mock
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_MODEL=gemini-2.5-flash

OPENAI_MODE=mock
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1/embeddings
OPENAI_MODEL=text-embedding-3-small

EMBEDDING_DIM=1536
MAX_SEARCH_LIMIT=30
JOB_POLL_INTERVAL=3s
